<?xml version="1.0" encoding="utf-8"?>
<!-- A player drawing into a TextureView rather than the default SurfaceView: a SurfaceView is a
     hole punched through to a separate surface and ignores view transforms, so it cannot be
     pinched or panned. The surface type can only be chosen by attribute, hence a layout. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view" />
