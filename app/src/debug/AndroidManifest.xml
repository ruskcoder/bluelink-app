<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: lets the web bridge reach a relay running on the development PC over plain
    ws://<lan-ip>:8787. Frames are end-to-end encrypted regardless; release builds speak wss:// only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
